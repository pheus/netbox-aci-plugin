include CONTRIBUTING.md
include LICENSE
include README.md
include CHANGELOG.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include Makefile
include mkdocs.yml

# Package assets for NetBox
recursive-include netbox_aci_plugin/locale *
recursive-include netbox_aci_plugin/templates *.html
recursive-include netbox_aci_plugin/static *

# Documentation
recursive-include docs *
prune docs/site

# Tests
recursive-include netbox_aci_plugin/tests *
include .ci/configuration.testing.py

# Housekeeping
global-exclude __pycache__ *.py[cod] .DS_Store .ruff_cache
global-exclude .coverage coverage.xml
prune .pytest_cache
